{
  "name": "@stone-js/monorepo",
  "version": "0.3.0",
  "private": true,
  "description": "The Continuum framework. Write your TypeScript domain once; it runs anywhere: Node, serverless, edge, browser, CLI and AI agents. Build once, deploy anywhere.",
  "type": "module",
  "engines": {
    "node": ">=22.22.1",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.12.3",
  "scripts": {
    "build": "pnpm -r run build",
    "clean": "pnpm -r run clean",
    "rebuild": "pnpm run clean && pnpm run build",
    "doc": "pnpm -r run doc",
    "test": "pnpm -r run test",
    "test:coverage": "pnpm -r run test:cvg",
    "lint": "pnpm -r run lint",
    "build:ci": "pnpm -r --filter='!@stone-js/website' --filter='!@stone-js/lab-*' --filter='!@stone-js/starters' --filter='!@stone-js/blog-starters' run build",
    "test:ci": "pnpm -r --filter='!@stone-js/website' --filter='!@stone-js/lab-*' --filter='!@stone-js/starters' --filter='!@stone-js/blog-starters' run test:cvg",
    "test:lab": "pnpm -r --filter='@stone-js/lab-*' run test",
    "lint:ci": "pnpm -r --filter='!@stone-js/website' --filter='!@stone-js/lab-*' --filter='!@stone-js/starters' --filter='!@stone-js/blog-starters' run lint",
    "verify": "pnpm run lint:ci && pnpm run build:ci && pnpm run test:ci && pnpm run audit:ci && pnpm run check:dts",
    "audit:ci": "node scripts/audit-lockfiles.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-external-versions.mjs",
    "release": "pnpm run clean && pnpm run build:ci && changeset publish",
    "prepare": "husky",
    "sync:versions": "node scripts/sync-external-versions.mjs",
    "check:dts": "node scripts/check-dts-extensions.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "ts-standard": "^12.0.2",
    "turbo": "^2.10.11"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server@<2.0.5": "^2.0.5",
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@2": "^2.1.4",
      "brace-expansion@5": "^5.0.9",
      "fast-uri@<4.1.2": "^4.1.2",
      "hono@<4.12.34": "^4.12.34",
      "ip-address@<10.3.1": "^10.3.1",
      "js-yaml@4": "^4.3.1",
      "js-yaml@<3.15.1": "^3.15.1",
      "nanoid@3": "^3.3.18",
      "postcss@<8.5.23": "^8.5.23",
      "uuid@<11.1.1": "^11.1.1"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-mh99-v99m-4gvg"
      ]
    }
  },
  "keywords": [
    "stone.js",
    "continuum",
    "micro-kernel",
    "monorepo"
  ],
  "license": "MIT"
}
