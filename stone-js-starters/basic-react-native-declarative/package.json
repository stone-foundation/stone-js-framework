{
  "name": "basic-react-native-declarative",
  "private": true,
  "version": "1.0.0",
  "description": "Stone.js's basic starter to create a React Native (Expo) app using the declarative API.",
  "author": "Mr. Stone <evensstone@gmail.com>",
  "license": "MIT",
  "main": "index.ts",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export": "expo export",
    "modules": "node -e \"require('@stone-js/use-react-native/metro').writeManifest(process.cwd())\"",
    "typecheck": "npm run modules && tsc --noEmit",
    "test": "vitest run",
    "test:cvg": "npm run test -- --coverage"
  },
  "dependencies": {
    "@stone-js/browser-core": "^0.8.13",
    "@stone-js/core": "^0.8.13",
    "@stone-js/react-native-adapter": "^0.8.13",
    "@stone-js/router": "^0.8.13",
    "@stone-js/use-react-native": "^0.8.13",
    "expo": "~57.0.14",
    "expo-status-bar": "~57.0.1",
    "fast-text-encoding": "^1.0.6",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-url-polyfill": "^3.0.0"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.28.0",
    "@stone-js/cli": "^0.8.13",
    "@stone-js/testing": "^0.8.13",
    "@types/react": "~19.2.2",
    "@vitest/coverage-v8": "^3.0.9",
    "babel-preset-expo": "^57.0.7",
    "typescript": "~6.0.3",
    "vitest": "^3.0.9"
  }
}
