{
  "name": "@stone-js/website",
  "private": true,
  "version": "0.0.0",
  "description": "The Stone.js website and documentation. Built with Stone.js itself (use-react, SSG): the site is the proof.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "sync:version": "node scripts/sync-version.mjs",
    "dev": "node scripts/sync-version.mjs && stone dev",
    "build": "node scripts/sync-version.mjs && stone build --ssg && node scripts/build-api.mjs && node scripts/build-feed.mjs",
    "build:app": "node scripts/sync-version.mjs && stone build",
    "api": "node scripts/sync-version.mjs && node scripts/build-api.mjs",
    "preview": "node scripts/sync-version.mjs && stone preview"
  },
  "dependencies": {
    "@docsearch/js": "^3.9.0",
    "@stone-js/browser-adapter": "workspace:*",
    "@stone-js/core": "workspace:*",
    "@stone-js/node-http-adapter": "workspace:*",
    "@stone-js/router": "workspace:*",
    "@stone-js/use-react": "workspace:*",
    "prismjs": "^1.30.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.25.9",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-typescript": "^7.27.0",
    "@stone-js/cli": "workspace:*",
    "@types/node": "^24.0.7",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "typedoc": "^0.28.20"
  }
}
